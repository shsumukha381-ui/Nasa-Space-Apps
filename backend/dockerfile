FROM python:3.11-slim

ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

COPY requirements.txt constraints.txt ./
RUN --mount=type=cache,target=/root/.cache/pip python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install -c constraints.txt -r requirements.txt \
    && /opt/venv/bin/python -m pip check

RUN groupadd --gid 10001 astrotwin \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin astrotwin

COPY . .
USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=5s --timeout=4s --start-period=15s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3).close()"]

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
